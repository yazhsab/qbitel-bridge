---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/hero/PageHero.astro';
import CTABanner from '@/components/cta/CTABanner.astro';
import RoadmapStudio from '@/components/interactive/RoadmapStudio';
---

<PageLayout
  title="Roadmap | QBITEL"
  description="QBITEL roadmap focused on one buyer journey: critical system discovery, behavior intelligence, modernization assets, governed protection, and evidence-led proof."
>
  <PageHero
    title="Product Roadmap"
    description="A 24-month roadmap built around one clear motion: inventory critical systems, understand behavior and risk, generate modernization deliverables, apply protection where it fits, and prove control with evidence."
    badge="Updated April 22, 2026"
  />

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 md:grid-cols-3">
        <div class="card p-6">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-neon-cyan/80">
            Phase 1
          </div>
          <h2 class="mt-3 text-xl font-semibold text-white">Discovery, understanding, and modernization core</h2>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Make protocol inventory, behavior intelligence, graphing, spec review, and adapter
            generation the center of the product.
          </p>
        </div>

        <div class="card p-6">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-neon-cyan/80">
            Phase 2
          </div>
          <h2 class="mt-3 text-xl font-semibold text-white">Protection and PQC transition</h2>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Add crypto posture mapping, dual-stack migration paths, and governed rollout controls
            that fit real operational constraints.
          </p>
        </div>

        <div class="card p-6">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-neon-cyan/80">
            Phase 3
          </div>
          <h2 class="mt-3 text-xl font-semibold text-white">Proof and scale</h2>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Turn approvals, attestation, evidence packs, and reusable vertical templates into a
            repeatable enterprise motion.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <RoadmapStudio client:load />
    </div>
  </section>

  <CTABanner
    title="Roadmap discipline matters more than breadth"
    description="QBITEL gets stronger by sequencing discovery, understanding, modernization, protection, and proof cleanly instead of adding more disconnected feature areas."
  />
</PageLayout>
