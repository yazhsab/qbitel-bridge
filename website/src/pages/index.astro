---
import LandingLayout from '@/layouts/LandingLayout.astro';
import CTABanner from '@/components/cta/CTABanner.astro';
import DomainDemoLab from '@/components/interactive/DomainDemoLab';
import OutcomeCalculator from '@/components/interactive/OutcomeCalculator';
import PlatformExplorer from '@/components/interactive/PlatformExplorer';
import { maturitySummary } from '@/data/pqcAudit';
import { productModules, proofArtifacts, signalMetrics } from '@/data/strategy';
import { url } from '@/utils/url';

const challengeCards = [
  {
    title: 'Unknown critical systems',
    description:
      'BPO voice platforms, IoT fleets, mainframes, defense networks, OT systems, and telecom cores still depend on protocols and workflows few teams fully understand.',
    signal: 'Build the asset, protocol, dependency, and ownership graph from traffic, logs, captures, and samples.',
  },
  {
    title: 'Modernization without replacement',
    description:
      'Teams need reviewed specs, adapters, APIs, and replay harnesses before they can move anything safely into a modern architecture.',
    signal: 'Generate integration assets and governed rollout plans instead of one-off migration projects.',
  },
  {
    title: 'Future risk with real constraints',
    description:
      'Organizations need fraud reduction, cyber resilience, PQC migration, and regulatory proof that fit latency, certification, uptime, and air-gap boundaries.',
    signal: 'Apply controlled overlays and prove changes with evidence packs, approvals, and rollback paths.',
  },
];

const deliveryStack = [
  {
    label: 'Rust dataplane',
    detail: 'Performance-sensitive cryptography, transport, and enforcement surfaces.',
  },
  {
    label: 'Python AI engine',
    detail: 'Protocol discovery, asset inference, modernization workflows, and evidence generation.',
  },
  {
    label: 'Go control plane',
    detail: 'Policy distribution, deployment orchestration, and approval-led rollout controls.',
  },
  {
    label: 'Astro + React website',
    detail: 'Interactive product narrative, roadmap, and implementation review surfaces.',
  },
];
---

<LandingLayout
  title="QBITEL | Critical Systems Intelligence and Protection"
  description="QBITEL discovers, understands, modernizes, protects, and proves control over critical legacy, voice, IoT, defense, industrial, healthcare, banking, and telecom systems."
>
  <section class="relative overflow-hidden border-b border-surface-600/50">
    <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-15" />
    <div class="absolute -left-24 top-24 h-80 w-80 rounded-full bg-neon-copper/15 blur-3xl" />
    <div class="absolute right-0 top-0 h-96 w-96 rounded-full bg-neon-cyan/10 blur-3xl" />

    <div class="relative mx-auto max-w-7xl px-4 pb-14 pt-24 sm:px-6 lg:px-8 lg:pb-16 lg:pt-24">
      <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-surface-600/60 bg-surface-800/70 px-4 py-1.5 text-sm text-slate-200">
            <span class="h-2 w-2 rounded-full bg-neon-green" />
            Critical systems intelligence with governed protection
          </div>

          <h1 class="mt-5 max-w-4xl text-4xl font-bold leading-[1.05] text-white sm:text-5xl xl:text-[3.45rem]">
            Turn unknown critical systems
            <span class="gradient-text"> into governed, modern, quantum-safe infrastructure.</span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            QBITEL helps enterprises discover, understand, modernize, protect, and prove control
            over systems they cannot easily replace: BPO call centers, IoT fleets, defense
            networks, banking mainframes, telecom cores, healthcare devices, and industrial
            infrastructure.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href={url('/enterprise')} class="btn-primary text-base">
              Request assessment
            </a>
            <a href={url('/demo-lab')} class="btn-secondary text-base">
              Try Demo Lab
            </a>
            <a href={url('/products')} class="btn-ghost text-base">
              Explore platform
            </a>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <span class="badge">Discover</span>
            <span class="badge">Understand</span>
            <span class="badge">Modernize</span>
            <span class="badge">Protect</span>
            <span class="badge">Prove</span>
          </div>
        </div>

        <div class="card overflow-hidden">
          <div class="border-b border-surface-600/60 p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.32em] text-neon-cyan/80">
              What the workflow produces
            </p>
            <h2 class="mt-3 text-xl font-bold text-white">
              One operating sequence instead of disconnected feature claims.
            </h2>
          </div>

          <div class="grid gap-3 p-5">
            {productModules.map((module, index) => (
              <div class="rounded-2xl border border-surface-600/70 bg-surface-900/70 p-4">
                <div class="flex items-center gap-3">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-surface-600 bg-surface-950 text-xs font-bold text-slate-300">
                    0{index + 1}
                  </div>
                  <span class={`inline-flex rounded-full bg-gradient-to-r px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-white ${module.color}`}>
                    {module.label}
                  </span>
                </div>
                <h3 class="mt-3 text-base font-semibold text-white">{module.headline}</h3>
                <p class="mt-1 line-clamp-2 text-sm leading-6 text-slate-300">{module.summary}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-4 md:grid-cols-4">
        {signalMetrics.map((metric) => (
          <div class="card p-5">
            <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-400">
              {metric.label}
            </div>
            <div class="mt-3 text-2xl font-bold text-white">{metric.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="section-heading">
          One platform. <span class="gradient-text">Vertical solution packs.</span>
        </h2>
        <p class="section-subheading mx-auto">
          QBITEL stays unified at the platform layer while each industry gets protocols,
          datasets, compliance mappings, risk models, and deployment playbooks tailored to its
          operational reality.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {challengeCards.map((card) => (
          <div class="card p-6">
            <h3 class="text-xl font-semibold text-white">{card.title}</h3>
            <p class="mt-4 text-sm leading-7 text-slate-300">{card.description}</p>
            <div class="mt-5 rounded-2xl border border-neon-cyan/20 bg-neon-cyan/10 p-4 text-sm leading-6 text-neon-cyan">
              {card.signal}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <h2 class="section-heading">
          Interactive <span class="gradient-text">Platform Explorer</span>
        </h2>
        <p class="section-subheading mx-auto">
          Explore the five-module workflow and switch between vertical messages without leaving
          the page.
        </p>
      </div>

      <PlatformExplorer client:load />
    </div>
  </section>

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <h2 class="section-heading">
          Bring Your Own <span class="gradient-text">Domain Data</span>
        </h2>
        <p class="section-subheading mx-auto">
          Paste BPO, IoT, defense, banking, OT, healthcare, telecom, or mobility samples and see
          an explainable QBITEL workflow directly in the browser.
        </p>
      </div>

      <DomainDemoLab client:load />
    </div>
  </section>

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <h2 class="section-heading">
          Interactive <span class="gradient-text">Program Outcome Model</span>
        </h2>
        <p class="section-subheading mx-auto">
          Compare a manual modernization effort against a QBITEL-style delivery motion using your
          own ranges.
        </p>
      </div>

      <OutcomeCalculator client:load />
    </div>
  </section>

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <h2 class="section-heading">
            Every delivery ends with an <span class="gradient-text">evidence pack</span>
          </h2>
          <p class="text-lg leading-8 text-slate-300">
            QBITEL packages the full record of what changed, why it changed, how it was validated,
            and which controls govern it in production.
          </p>

          <div class="mt-8 grid gap-3">
            {proofArtifacts.map((artifact) => (
              <div class="rounded-2xl border border-surface-600/70 bg-surface-800/80 p-4 text-sm text-slate-200">
                {artifact}
              </div>
            ))}
          </div>
        </div>

        <div class="card p-6">
          <div class="text-xs font-semibold uppercase tracking-[0.32em] text-neon-copper/80">
            Delivery stack
          </div>
          <div class="mt-5 grid gap-4">
            {deliveryStack.map((item) => (
              <div class="rounded-3xl border border-surface-600/70 bg-surface-900/70 p-5">
                <h3 class="text-lg font-semibold text-white">{item.label}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-300">{item.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-surface-600/60 bg-surface-800/70 px-4 py-1.5 text-sm text-slate-200">
            <span class="h-2 w-2 rounded-full bg-neon-copper" />
            Code-level implementation signal
          </div>
          <h2 class="mt-6 section-heading">
            Technical transparency.
            <span class="gradient-text"> Clear maturity signals for PQC rollout.</span>
          </h2>
          <p class="text-lg leading-8 text-slate-300">
            QBITEL separates production-grade primitives, guarded wrappers, and prototype domain
            modules so enterprise teams can plan a controlled hardening and rollout path.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href={url('/pqc-audit')} class="btn-primary">
              Open implementation review
            </a>
            <a href={url('/products/post-quantum-crypto')} class="btn-secondary">
              See PQC product page
            </a>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {maturitySummary.map((item) => (
            <div class="card p-6">
              <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-400">
                {item.label}
              </div>
              <div class="mt-3 text-3xl font-bold text-white">{item.value}</div>
              <p class="mt-3 text-sm leading-6 text-slate-300">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    title="Start with protocol inventory, then expand into modernization and PQC rollout"
    description="Start with a concrete assessment, produce a protocol inventory, then expand into modernization, governed protection, and evidence-backed rollout."
  />
</LandingLayout>
