---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/hero/PageHero.astro';
import CTABanner from '@/components/cta/CTABanner.astro';
---

<PageLayout
  title="Governed Protection Engine | QBITEL Bridge"
  description="Policy-led fraud, threat, and PQC protection with confidence scoring, approval gates, rollback paths, and full audit evidence."
>
  <PageHero
    title="Governed Protection Engine"
    description="Use AI-assisted decisions for fraud, threat, and runtime protection while keeping production-critical actions under approval, simulation, rollback, and evidence controls."
    badge="Controlled Security Automation"
    gradient="from-red-500 to-orange-500"
  />

  <!-- Key Metrics -->
  <section class="py-12 border-b border-surface-600/50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="card p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-1">Gated</div>
          <div class="text-sm text-gray-400">Critical Actions</div>
        </div>
        <div class="card p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-1">Sim</div>
          <div class="text-sm text-gray-400">Before Execution</div>
        </div>
        <div class="card p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-1">Full</div>
          <div class="text-sm text-gray-400">Audit Evidence</div>
        </div>
        <div class="card p-6 text-center">
          <div class="text-3xl font-bold gradient-text mb-1">Fail</div>
          <div class="text-sm text-gray-400">Closed by Default</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="py-16 lg:py-24 border-b border-surface-600/50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="section-heading">
            The <span class="gradient-text">Control Challenge</span>
          </h2>
          <p class="text-gray-400 mb-6 leading-relaxed">
            Critical systems need faster decisions, but uncontrolled autonomy is hard to sell into banks, BPOs, defense networks, hospitals, telecom cores, and OT environments.
          </p>
          <p class="text-gray-400 leading-relaxed">
            The Governed Protection Engine uses AI-assisted reasoning to triage fraud, threat, and runtime events while enforcing approval gates, blast-radius limits, rollback paths, and evidence collection.
          </p>
        </div>
        <div class="space-y-4">
          <div class="card p-5">
            <div class="text-white font-semibold mb-2">Ungoverned Automation</div>
            <div class="flex items-center gap-3 mb-2">
              <div class="flex-1 h-2 rounded-full bg-surface-700 overflow-hidden">
                <div class="h-full bg-red-500 rounded-full" style="width: 100%"></div>
              </div>
              <span class="text-sm text-red-400 font-mono">65 min</span>
            </div>
            <div class="text-xs text-gray-500">Fast action without proof creates adoption risk</div>
          </div>
          <div class="card p-5">
            <div class="text-white font-semibold mb-2">Governed Protection</div>
            <div class="flex items-center gap-3 mb-2">
              <div class="flex-1 h-2 rounded-full bg-surface-700 overflow-hidden">
                <div class="h-full bg-neon-green rounded-full" style="width: 2%"></div>
              </div>
              <span class="text-sm text-neon-green font-mono">Approved</span>
            </div>
            <div class="text-xs text-gray-500">Controlled action with evidence</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-16 lg:py-24 border-b border-surface-600/50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="section-heading">
          Core <span class="gradient-text">Capabilities</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-red-500/10 border border-red-500/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white">LLM Decision Engine</h3>
          </div>
          <p class="text-gray-400 text-sm mb-4">Uses large language models for nuanced threat assessment, combining contextual understanding with security domain knowledge to make accurate response decisions.</p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Context-aware threat assessment
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              94% decision accuracy on known patterns
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Explainable AI reasoning for every decision
            </li>
          </ul>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-orange-500/10 border border-orange-500/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white">MITRE ATT&CK Mapping</h3>
          </div>
          <p class="text-gray-400 text-sm mb-4">Every detected threat is automatically mapped to MITRE ATT&CK techniques, tactics, and procedures, providing standardized threat classification and response playbooks.</p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Full MITRE ATT&CK framework coverage
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Automated playbook execution per technique
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Threat hunting based on TTP patterns
            </li>
          </ul>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-yellow-500/10 border border-yellow-500/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white">On-Premise LLM (Ollama)</h3>
          </div>
          <p class="text-gray-400 text-sm mb-4">Run the entire decision engine on-premise using Ollama. Sensitive security data never leaves your network, meeting the strictest data sovereignty requirements.</p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Zero data exfiltration risk
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Air-gapped environment support
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Data sovereignty compliance
            </li>
          </ul>
        </div>

        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white">Automated Response</h3>
          </div>
          <p class="text-gray-400 text-sm mb-4">Execute containment, remediation, and recovery actions automatically. Configurable confidence thresholds ensure human oversight where needed.</p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              78% of incidents fully automated
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Configurable automation thresholds
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-neon-green flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Full audit trail for compliance
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Architecture -->
  <section class="py-16 lg:py-24 border-b border-surface-600/50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="section-heading">
          Decision <span class="gradient-text">Flow</span>
        </h2>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-red-500 to-orange-500 text-white font-bold text-sm flex-shrink-0 mt-1">1</div>
          <div class="card p-4 flex-1">
            <h3 class="text-white font-semibold mb-1">Alert Ingestion</h3>
            <p class="text-sm text-gray-400">Ingest alerts from SIEM, IDS/IPS, EDR, cloud security tools, and custom sources via standardized connectors.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-red-500 to-orange-500 text-white font-bold text-sm flex-shrink-0 mt-1">2</div>
          <div class="card p-4 flex-1">
            <h3 class="text-white font-semibold mb-1">Context Enrichment</h3>
            <p class="text-sm text-gray-400">Enrich alerts with threat intelligence, asset context, user behavior profiles, and historical incident data.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-red-500 to-orange-500 text-white font-bold text-sm flex-shrink-0 mt-1">3</div>
          <div class="card p-4 flex-1">
            <h3 class="text-white font-semibold mb-1">LLM Analysis</h3>
            <p class="text-sm text-gray-400">The LLM decision engine analyzes the enriched alert, determines severity, and recommends response actions with confidence scores.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-red-500 to-orange-500 text-white font-bold text-sm flex-shrink-0 mt-1">4</div>
          <div class="card p-4 flex-1">
            <h3 class="text-white font-semibold mb-1">Governed Response</h3>
            <p class="text-sm text-gray-400">Low-risk decisions can be automated by policy. Critical production actions require approval gates, rollback context, and full evidence.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    title="Ready for governed protection?"
    description="Deploy AI-assisted protection with approval gates, rollback paths, and evidence that critical-system buyers can trust."
  />
</PageLayout>
