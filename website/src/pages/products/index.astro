---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/hero/PageHero.astro';
import CTABanner from '@/components/cta/CTABanner.astro';
import OutcomeCalculator from '@/components/interactive/OutcomeCalculator';
import PlatformExplorer from '@/components/interactive/PlatformExplorer';
import { productModules, proofArtifacts } from '@/data/strategy';
import { url } from '@/utils/url';
---

<PageLayout
  title="Platform | QBITEL"
  description="Explore the QBITEL platform: discover critical systems, understand behavior and risk, generate modernization assets, apply governed protection, and package deployment evidence."
>
  <PageHero
    title="The QBITEL Platform"
    description="A focused five-module product for critical system discovery, behavior intelligence, modernization, quantum-safe protection, and evidence-led proof."
    badge="Discover · Understand · Modernize · Protect · Prove"
  />

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {productModules.map((module, index) => (
          <article class="card p-6">
            <div class="flex items-center justify-between">
              <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-400">
                0{index + 1}
              </div>
              <span class={`inline-flex rounded-full bg-gradient-to-r px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-white ${module.color}`}>
                {module.label}
              </span>
            </div>
            <div class="mt-4 text-xs font-semibold uppercase tracking-[0.24em] text-neon-copper/80">
              {module.eyebrow}
            </div>
            <h2 class="mt-3 text-xl font-semibold text-white">{module.headline}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-300">{module.summary}</p>
            <a href={url(module.href)} class="mt-5 inline-flex text-sm font-medium text-neon-cyan transition-colors hover:text-white">
              Open module page
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <h2 class="section-heading">
          Interactive <span class="gradient-text">Workflow Explorer</span>
        </h2>
        <p class="section-subheading mx-auto">
          Move between the platform workflow and the vertical story without leaving the page.
        </p>
      </div>

      <PlatformExplorer client:load />
    </div>
  </section>

  <section class="border-b border-surface-600/50 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
        <h2 class="section-heading">
          Proof is part of the product, not an afterthought.
        </h2>
        <p class="text-lg leading-8 text-slate-300">
            QBITEL should ship inventory, behavior intelligence, modernization assets,
            protection plans, and a clean package of lineage, approvals, and deployment evidence
            in the same workflow.
          </p>

          <div class="mt-8 grid gap-3">
            {proofArtifacts.map((artifact) => (
              <div class="rounded-2xl border border-surface-600/70 bg-surface-800/80 p-4 text-sm text-slate-200">
                {artifact}
              </div>
            ))}
          </div>
        </div>

        <OutcomeCalculator client:load />
      </div>
    </div>
  </section>

  <CTABanner
    title="Review the platform and vertical solution-pack strategy"
    description="Use the platform explorer to understand the workflow, then inspect the PQC audit before positioning domain-specific cryptography as production-ready."
  />
</PageLayout>
