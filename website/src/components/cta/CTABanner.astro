---
import { url } from '@/utils/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ready to bring critical systems under control?',
  description = 'Start with a focused assessment, then expand into protocol inventory, modernization, governed protection, and evidence-backed rollout.',
} = Astro.props;
---

<section class="relative py-16 lg:py-24 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-quantum-900/60 via-surface-900 to-quantum-900/60" />
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-20" />
  <div class="absolute left-[-8rem] top-[-8rem] w-72 h-72 rounded-full bg-neon-copper/15 blur-3xl" />
  <div class="absolute right-[-8rem] bottom-[-8rem] w-72 h-72 rounded-full bg-neon-cyan/15 blur-3xl" />
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-neon-cyan/70 to-transparent" />
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-neon-cyan/70 to-transparent" />

  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h2>
    <p class="text-lg text-slate-300 mb-8 max-w-2xl mx-auto">{description}</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href={url('/enterprise')} class="btn-primary text-base">
        Request assessment
        <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <a href={url('/demo-lab')} class="btn-secondary text-base">
        Try Demo Lab
      </a>
      <a href={url('/docs/getting-started/quickstart')} class="btn-ghost text-base">
        Quick Start
      </a>
    </div>
  </div>
</section>
